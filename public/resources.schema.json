{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cphyc/halo-viewer/resources.schema.json",
  "title": "Halo Viewer Resources Schema",
  "description": "Schema for defining available data resources in the Halo Viewer",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "description": "Root metadata that defines the main grouping of the data (e.g., simulation name)"
    },
    "structure": {
      "type": "array",
      "description": "List of nested metadata that parametrize resources. Each metadata must have a unique 'id' field.",
      "items": {
        "$ref": "#/definitions/structure"
      }
    },
    "resources": {
      "type": "array",
      "description": "List of available data resources. Each resource must have a unique 'id' field.",
      "items": {
        "$ref": "#/definitions/resource"
      }
    }
  },
  "required": ["root", "resources", "structure"],
  "additionalProperties": false,
  "definitions": {
    "structure": {
      "type": "object",
      "description": "List of nested metadata that parametrize resources.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Name of the metadata"
        },
        "name": {
          "type": "string",
          "description": "Display name of the metadata"
        },
        "requires": {
          "type": "array",
          "description": "List of other metadata IDs that this metadata depends on",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "derived_from": {
          "type": "string",
          "description": "A valid JavaScript expression to derive this metadata from the required metadata. Used to automatically compute a metadata from another one.",
          "default": ""
        },
        "pathTemplate": {
          "type": "string",
          "description": "Path for accessing the data in JSON format",
          "default": ""
        },
        "idKey": {
          "type": "string",
          "description": "Key to access the ids in the JSON",
          "default": ""
        },
        "valueKey": {
          "type": "string",
          "description": "Key to access the value in the JSON",
          "default": ""
        },
        "parser": {
          "type": "string",
          "description": "Parser to use for loading data. Options: 'json' (default), 'namespace.name' (local parser like 'ascii.rockstarCatalogue'), or 'custom:url#functionName' (external parser)",
          "default": "json"
        }
      },
      "required": ["id", "name"]
    },
    "resource": {
      "type": "object",
      "description": "A data resource",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this resource type"
        },
        "name": {
          "type": "string",
          "description": "Display name for this resource"
        },
        "type": {
          "type": "string",
          "enum": ["1D", "2D", "3D", "table"],
          "description": "Type of the resource (1D, 2D, 3D, table)"
        },
        "bucket_size": {
          "type": "integer",
          "description": "Number of object per bucket (for bucketed resources). Set to 0 for unbucketed resources. Only allowed for 1D resources.",
          "default": 0
        },
        "pathTemplate": {
          "type": "string",
          "description": "Path template for accessing the data. Use {haloId} for halo ID, {bucketId} for bucket ID (haloId / 1000)"
        },
        "dataKey": {
          "type": "string",
          "description": "Key to access the data in the JSON (for bucketed resources)"
        },
        "xAxis": {
          "$ref": "#/definitions/axis",
          "description": "X-axis configuration (for 1D and 2D data)"
        },
        "yAxis": {
          "$ref": "#/definitions/axis",
          "description": "Y-axis configuration (for 1D data)"
        },
        "downloadable": {
          "type": "boolean",
          "default": true,
          "description": "Whether the data can be downloaded"
        },
        "requires": {
          "type": "array",
          "description": "List of other resource IDs that this resource depends on",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "parser": {
          "type": "string",
          "description": "Parser to use for loading resource data. Options: 'json' (default), 'namespace.name' (local parser), or 'custom:url#functionName' (external parser)",
          "default": "json"
        }
      },
      "required": ["id", "name", "type"],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["2D", "3D"]
              }
            }
          },
          "then": {
            "properties": {
              "bucket_size": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["1D", "2D"]
              }
            }
          },
          "then": {
            "required": ["xAxis", "yAxis"]
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "type": {
                    "enum": ["1D", "2D", "3D"]
                  }
                }
              },
              {
                "properties": {
                  "bucket_size": {
                    "not": {
                      "const": 0
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": ["dataKey"]
          }
        }
      ]
    },
    "axis": {
      "type": "object",
      "description": "Axis configuration for plotting",
      "properties": {
        "label": {
          "type": "string",
          "description": "Label for the axis (e.g., 'λ', 'fλ')"
        },
        "unit": {
          "type": "string",
          "description": "Unit for the axis (e.g., 'Å', 'arbitrary units')"
        },
        "key": {
          "type": "string",
          "description": "Key in the data object for this axis"
        }
      },
      "required": ["label", "unit"]
    }
  }
}
