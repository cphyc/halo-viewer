{
  "root": "simulation_name",
  "structure": [
    {
      "id": "simulationId",
      "name": "Simulation name",
      "pathTemplate": "data/simulations.json",
      "idKey": "simulations",
      "valueKey": "simulations"
    },
    {
      "id": "outputId",
      "name": "Output ID",
      "requires": ["simulationId"],
      "pathTemplate": "data/catalogues/{simulationId}/outputs.json",
      "idKey": "outputId",
      "valueKey": "name"
    },
    {
      "id": "haloId",
      "name": "Halo ID",
      "requires": ["simulationId", "outputId"],
      "pathTemplate": "data/catalogues/{simulationId}/halos_{outputId}.0.ascii",
      "parser": "ascii.rockstarCatalogue",
      "idKey": "ids",
      "valueKey": "labels"
    },
    {
      "id": "haloBucketId",
      "name": "Bucket of the halo",
      "requires": ["haloId"],
      "derived_from": "Math.floor(haloId / 1000)"
    }
  ],
  "resources": [
    {
      "id": "spectrum",
      "name": "Spectra",
      "type": "1D",
      "bucket_size": 1000,
      "pathTemplate": "data/spectra/{simulationId}/output_{outputId}/halos_{haloBucketId}.json.gz",
      "dataKey": "data",
      "xAxis": {
        "label": "λ",
        "unit": "Å",
        "key": "wavelength"
      },
      "yAxis": {
        "label": "fλ",
        "unit": "arbitrary units",
        "key": "total"
      },
      "downloadable": true,
      "requires": ["simulationId", "outputId", "haloId"]
    },
    {
      "id": "nebc",
      "name": "Spectra (nebular continuum)",
      "type": "1D",
      "bucket_size": 1000,
      "pathTemplate": "data/spectra/{simulationId}/output_{outputId}/halos_{haloBucketId}.json.gz",
      "dataKey": "data",
      "xAxis": {
        "label": "λ",
        "unit": "Å",
        "key": "wavelength"
      },
      "yAxis": {
        "label": "fλ",
        "unit": "arbitrary units",
        "key": "nebc"
      },
      "downloadable": true,
      "requires": ["simulationId", "outputId", "haloId"]
    },
    {
      "id": "mock",
      "name": "Mock images",
      "type": "2D",
      "bucket_size": 0,
      "pathTemplate": "data/mocks/{simulationId}/output_{outputId}/halos_{haloId}.png",
      "xAxis": {
        "label": "x",
        "unit": "kpc"
      },
      "yAxis": {
        "label": "y",
        "unit": "kpc"
      },
      "downloadable": true,
      "requires": ["simulationId", "outputId", "haloId"]
    }
  ]
}
